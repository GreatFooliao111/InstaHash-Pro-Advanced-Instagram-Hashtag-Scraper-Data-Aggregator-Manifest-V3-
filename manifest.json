{
  "manifest_version": 3,
  "name": "Instagram Hashtag Scraper Pro",
  "version": "1.0.0",
  "description": "Enterprise-grade Instagram hashtag data scraper with deduplication and CSV export",
  "permissions": [
    "storage",
    "offscreen",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["src/content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/injected/main-world.js",
        "src/content/content-script-enhanced.js"
      ],
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"]
    }
  ],
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "Instagram Hashtag Scraper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/ui/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
